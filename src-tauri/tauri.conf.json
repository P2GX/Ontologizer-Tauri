{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ontologizer",
  "version": "0.1.1",
  "identifier": "com.ontologizer.app",
  "build": {
    "frontendDist": "../dist/ontologizer/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build -- --configuration=production"
  },
  "app": {
    "security": {
    },
    "windows": [
      {
        "title": "Ontologizer",
        "width": 1300,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}